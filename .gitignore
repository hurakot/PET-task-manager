# --- Секреты: НИКОГДА не коммитить ---
.env
.env.*
# Шаблон без секретов коммитить нужно
!.env.example

# --- Виртуальное окружение ---
venv/
.venv/
env/

# --- Кэш Python и инструментов ---
__pycache__/
*.py[cod]
.mypy_cache/
.ruff_cache/

# --- Сборка пакетов ---
build/
dist/
*.egg-info/

# --- Тесты и покрытие ---
.pytest_cache/
.coverage
htmlcov/

# --- Локальные базы и бэкапы (содержат хэши паролей) ---
*.db
*.sqlite3
*.sql
backup_*

# --- Логи ---
*.log

# --- IDE / редакторы ---
.vscode/
.idea/

# --- Мусор macOS ---
.DS_Store
