
# Шаблон настроек. Скопируй: cp .env.example .env — и заполни своими значениями.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=pet1fastapidb

# Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
DATABASE_URL=postgresql+asyncpg://postgres:change_me@localhost:5432/pet1fastapidb
SECRET_KEY=change_me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
